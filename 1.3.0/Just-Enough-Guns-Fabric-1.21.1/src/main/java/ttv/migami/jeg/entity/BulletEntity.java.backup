            double theta = level.random.nextDouble() * Math.PI * 2;
            double phi = (level.random.nextDouble() - 0.5) * Math.PI;
            double outerX = pos.x + radius * Math.cos(theta) * Math.cos(phi);
            double outerY = pos.y + radius * Math.sin(phi) * 0.7;
            double outerZ = pos.z + radius * Math.sin(theta) * Math.cos(phi);

            int color = FLARE_BLAST_COLORS[level.random.nextInt(FLARE_BLAST_COLORS.length)];
            level.addParticle(new DustParticleOptions(color, 2.2F),
                outerX, outerY, outerZ,

    /**
     * Perform precise block raycast that better handles leaves and other penetrable blocks.
     * This allows bullets to pass through gaps between leaves that would otherwise be blocked.
     */
    private BlockHitResult performPreciseBlockRaycast(Vec3 start, Vec3 end) {
        // First try standard raycast
        ClipContext clipContext = new ClipContext(
            start,
            end,
            ClipContext.Block.OUTLINE,
            ClipContext.Fluid.NONE,
            this
        );
        BlockHitResult standardResult = this.level().clip(clipContext);
        
        // If no block hit, return miss
        if (standardResult.getType() == HitResult.Type.MISS) {
            return standardResult;
        }
        
        BlockPos hitPos = standardResult.getBlockPos();
        BlockState hitState = this.level().getBlockState(hitPos);
        
        // Check if hit block is penetrable
        if (BulletPenetrationHelper.isPenetrable(this.level(), hitState)) {
            // For penetrable blocks like leaves, use more lenient collision detection
            // Check if the bullet path actually goes through solid parts of the leaves
            if (shouldBlockPassThroughLeaves(start, end, hitPos, hitState)) {
                // Create a miss result to allow bullet to pass through
                return BlockHitResult.miss(standardResult.getLocation(), standardResult.getDirection(), hitPos);
            }
        }
        
        return standardResult;
    }
    
    /**
     * Determine if a bullet should pass through leaves based on actual leaf coverage.
     * This simulates the irregular shape of leaves.
     */
    private boolean shouldBlockPassThroughLeaves(Vec3 start, Vec3 end, BlockPos leafPos, BlockState leafState) {
        // Use random chance based on leaf type to simulate gaps in foliage
        double randomValue = this.level().random.nextDouble();
        
        // Different leaf types have different densities
        if (leafState.is(Blocks.OAK_LEAVES) || leafState.is(Blocks.BIRCH_LEAVES)) {
            return randomValue < 0.3; // 30% chance to pass through gaps
        } else if (leafState.is(Blocks.SPRUCE_LEAVES) || leafState.is(Blocks.DARK_OAK_LEAVES)) {
            return randomValue < 0.2; // 20% chance (denser needles)
        } else if (leafState.is(Blocks.ACACIA_LEAVES) || leafState.is(Blocks.JUNGLE_LEAVES)) {
            return randomValue < 0.35; // 35% chance (more spread out)
        } else {
            return randomValue < 0.25; // Default 25% chance
        }
    }
}
                0, 0, 0);

            if (distant % 4 == 0) {
                level.addParticle(ParticleTypes.EXPLOSION,
                    outerX, outerY, outerZ,
                    0, 0, 0);
            }
        }

        level.playLocalSound(pos.x, pos.y, pos.z,
            net.minecraft.sounds.SoundEvents.GENERIC_EXPLODE.value(),
            net.minecraft.sounds.SoundSource.PLAYERS,
            4.0F, (1.0F + (level.random.nextFloat() - level.random.nextFloat()) * 0.2F), false);

        level.playLocalSound(pos.x, pos.y, pos.z,
            net.minecraft.sounds.SoundEvents.FIREWORK_ROCKET_BLAST,
            net.minecraft.sounds.SoundSource.PLAYERS,
            4.0F, 0.9F + level.random.nextFloat() * 0.2F, false);
    }

    @Override
    public void handleEntityEvent(byte event) {
    	if (event == FLARE_DETONATION_EVENT) {
    	    spawnFlareExplosionEffectsClient();
    	    return;
    	}
    	super.handleEntityEvent(event);
    }


    private void spawnColoredDustBurst(Level level, double originX, double originY, double originZ, double dirX, double dirY, double dirZ) {
        double spread = 2.2;
        for (int color : FLARE_BLAST_COLORS) {
            for (int i = 0; i < 5; i++) {
                double velocityScale = 0.9 + level.random.nextDouble() * 2.2;
                level.addParticle(new DustParticleOptions(color, 2.6F),
                    originX + (level.random.nextDouble() - 0.5) * spread,
                    originY + (level.random.nextDouble() - 0.5) * spread,
                    originZ + (level.random.nextDouble() - 0.5) * spread,
                    dirX * velocityScale,
                    dirY * velocityScale,
                    dirZ * velocityScale);
            }
        }
    }

    /**
     * Send bullet trail data to all nearby clients
     */
    private void sendTrailToClients(Vec3 start, Vec3 end) {
        if (this.level().isClientSide() || !(this.level() instanceof ServerLevel serverLevel)) {
            return;
        }

        // Get trail properties
        int color = this.entityData.get(DATA_TRAIL_COLOR);
        float size = this.entityData.get(DATA_SIZE);
        boolean hitSolid = this.entityData.get(DATA_HIT_SOLID_BLOCK);

        // Create trail payload
        BulletTrailPayload payload = new BulletTrailPayload(start, end, color, size, hitSolid);

        // Send to all nearby players
        for (ServerPlayer player : serverLevel.getServer().getPlayerList().getPlayers()) {
            if (player.level() == serverLevel && player.distanceToSqr(this) <= 64.0 * 64.0) {
                player.connection.send(payload);
            }
        }
    }
}
